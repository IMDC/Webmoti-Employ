{
  "name": "@webmoti-employ/electron",
  "productName": "WebMoti-Employ",
  "version": "0.1.5",
  "description": "WebMoti-Employ desktop app",
  "author": "IMDC",
  "main": "dist/main.js",
  "scripts": {
    "start": "pnpm --prefix .. start",
    "typecheck": "tsc --noEmit",
    "gen-build-info": "node scripts/build-info.js",
    "dev:electron": "pnpm gen-build-info && rimraf dist && tsc && electron .",
    "build:electron": "pnpm gen-build-info && rimraf dist && tsc",
    "dist:win": "pnpm build:python && pnpm build:electron && electron-builder --win --x64",
    "dist:linux": "pnpm build:python && pnpm build:electron && electron-builder --linux --arm64",
    "dist:mac": "pnpm build:python && pnpm build:electron && electron-builder --mac --x64",
    "lint": "eslint .",
    "build:python": "cd python && uv sync && uv run pyinstaller main.py --onefile --name eyetracker --distpath dist --workpath build --hidden-import engineio.async_drivers.aiohttp --hidden-import engineio.async_aiohttp",
    "kill:python": "taskkill /F /IM python.exe"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "socket.io-client": "4.8.3",
    "tree-kill": "^1.2.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "electron": "40.8.0",
    "electron-builder": "^26.8.1"
  }
}
