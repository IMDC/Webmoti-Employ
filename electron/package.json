{
  "name": "@web-employ/electron",
  "productName": "WebMoti-Employ",
  "type": "module",
  "version": "0.0.0",
  "main": "dist/main.js",
  "scripts": {
    "dev:electron": "tsc && electron .",
    "build-client": "pnpm --filter @web-employ/client build:deploy",
    "dist:base": "tsc && pnpm run build-client",
    "dist:win": "pnpm run dist:base && electron-builder --win --x64",
    "dist:linux": "pnpm run dist:base && electron-builder --linux --arm64",
    "dist:mac": "pnpm run dist:base && electron-builder --mac --x64"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.16.2",
    "electron": "37.2.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.31.0",
    "typescript": "~5.8.3"
  }
}
