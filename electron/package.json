{
  "name": "@webmoti-employ/electron",
  "productName": "WebMoti-Employ",
  "version": "0.0.4",
  "description": "WebMoti-Employ desktop app",
  "author": "IMDC",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev:electron": "rimraf dist && tsc && electron .",
    "build:electron": "rimraf dist && tsc && cross-env VITE_IS_ELECTRON=true pnpm --filter @webmoti-employ/client build:deploy",
    "dist:win": "pnpm run build:electron && electron-builder --win --x64",
    "dist:linux": "pnpm run build:electron && electron-builder --linux --arm64",
    "dist:mac": "pnpm run build:electron && electron-builder --mac --x64",
    "lint": "eslint .",
    "build:python": "uv run pyinstaller python/main.py --onefile --name eyetracker --distpath python/dist --workpath python/build --hidden-import engineio.async_drivers.aiohttp --hidden-import engineio.async_aiohttp"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.2.1",
    "cross-env": "^10.0.0",
    "electron": "38.1.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.35.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.2"
  }
}
