{
  "name": "@web-employ/electron",
  "productName": "WebMoti-Employ",
  "version": "0.0.0",
  "description": "WebMoti-Employ desktop app",
  "author": "IMDC",
  "main": "dist/main.js",
  "scripts": {
    "dev:electron": "tsc && electron .",
    "build:electron": "tsc && cross-env VITE_IS_ELECTRON=true pnpm --filter @web-employ/client build:deploy",
    "dist:win": "pnpm run build:electron && electron-builder --win --x64",
    "dist:linux": "pnpm run build:electron && electron-builder --linux --arm64",
    "dist:mac": "pnpm run build:electron && electron-builder --mac --x64"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.16.2",
    "cross-env": "^7.0.3",
    "electron": "37.2.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.31.0",
    "typescript": "~5.8.3"
  }
}
