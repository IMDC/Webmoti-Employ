{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "icon": "./icon.png",
  "productName": "WebMoti-Employ",
  "appId": "com.imdc.webmoti-employ",
  "files": [
    "package.json",
    ".env.electron",
    {
      "from": "dist",
      "to": "dist"
    }
  ],
  "extraResources": [
    "dist/preload.cjs",
    "models"
  ],
  "win": {
    "target": ["portable"],
    "forceCodeSigning": false,
    "extraResources": [
      {
        "from": "python/dist/eyetracker.exe",
        "to": "eyetracker.exe"
      }
    ]
  },
  "linux": {
    "target": "AppImage",
    "category": "Telephony",
    "forceCodeSigning": false,
    "extraResources": [
      {
        "from": "python/dist/eyetracker",
        "to": "eyetracker"
      }
    ]
  },
  "mac": {
    "target": "dmg",
    "forceCodeSigning": false,
    "extraResources": [
      {
        "from": "python/dist/eyetracker",
        "to": "eyetracker"
      }
    ]
  }
}
