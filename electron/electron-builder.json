{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "icon": "./icon.png",
  "productName": "WebMoti-Employ",
  "appId": "com.imdc.webmoti-employ",
  "files": [
    "package.json",
    {
      "from": "../client/dist",
      "to": "client/dist",
      "filter": ["**/*"]
    },
    {
      "from": "dist",
      "to": "dist",
      "filter": ["**/*"]
    }
  ],
  "mac": { "target": "dmg" },
  "linux": { "target": "AppImage", "category": "Telephony" },
  "win": { "target": ["portable", "msi"] }
}
