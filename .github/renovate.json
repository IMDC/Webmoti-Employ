{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    "abandonments:recommended"
  ],
  "timezone": "America/Toronto",
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "labels": ["security"]
  },
  "packageRules": [
    // NPM ---------------------------------------------------
    {
      "description": "Group non-eslint npm minor updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor"],
      "matchPackageNames": ["!/eslint/"],
      "groupName": "minor updates"
    },
    {
      "description": "Group non-eslint npm patch updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch"],
      "matchPackageNames": ["!/eslint/"],
      "groupName": "patch updates"
    },
    {
      "description": "Group eslint-related minor/patch updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/eslint/"],
      "groupName": "eslint"
    },
    {
      "description": "Pinned packages: disabled due to compatibility issues",
      "matchPackageNames": ["wrangler", "vitest"],
      "enabled": false
    },
    // GitHub Actions ----------------------------------------
    {
      "description": "Group GitHub Actions minor/patch updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "github actions"
    },
    // UV ---------------------------------------------------
    {
      "description": "Group Python minor/patch updates",
      "matchManagers": ["pep621"],
      "matchFileNames": ["electron/python/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python dependencies"
    }
  ]
}
