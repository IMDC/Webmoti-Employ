{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    "helpers:pinGitHubActionDigests",
    ":configMigration"
  ],
  "timezone": "America/Toronto",
  "enabledManagers": ["npm", "github-actions", "pyenv", "pep621"],
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "labels": ["security"]
  },
  "packageRules": [
    // NPM ---------------------------------------------------
    {
      "description": "Group non-eslint npm minor updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor"],
      "matchPackageNames": ["!/eslint/"],
      "groupName": "minor updates group"
    },
    {
      "description": "Group non-eslint npm patch updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch"],
      "matchPackageNames": ["!/eslint/"],
      "groupName": "patch updates group"
    },
    {
      "description": "Group eslint-related minor/patch updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/eslint/"],
      "groupName": "eslint group"
    },
    {
      "description": "Pinned packages: disabled due to compatibility issues",
      "matchPackageNames": ["wrangler", "vitest"],
      "enabled": false
    },
    {
      "description": "Separate better-auth updates (minor versions can be breaking)",
      "matchManagers": ["npm"],
      "matchPackageNames": ["better-auth"],
      "groupName": "better-auth group",
      "separateMajorMinor": true
    },
    // GitHub Actions ----------------------------------------
    {
      "description": "Group GitHub Actions minor/patch updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "github actions group"
    },
    {
      "description": "Ignore digest-only updates for GitHub Actions (only notify on tagged releases)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    // UV ---------------------------------------------------
    {
      "description": "Pin .python-version to 3.10, matching requires-python",
      "matchManagers": ["pyenv"],
      "matchFileNames": ["electron/python/**"],
      "allowedVersions": "/^3\\.10/"
    },
    {
      "description": "Pin requires-python to 3.10 (project cannot use other versions)",
      "matchManagers": ["pep621"],
      "matchFileNames": ["electron/python/**"],
      "matchPackageNames": ["python"],
      "allowedVersions": "/^3\\.10/"
    },
    {
      "description": "Group Python minor/patch updates",
      "matchManagers": ["pep621"],
      "matchFileNames": ["electron/python/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python dependencies group"
    }
  ]
}
