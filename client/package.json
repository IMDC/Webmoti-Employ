{
  "name": "@webmoti-employ/client",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "start": "pnpm --prefix .. start",
    "dev": "vite",
    "dev:electron": "pnpm run dev",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "install:deploy": "pnpm install --filter @webmoti-employ/shared --filter @webmoti-employ/client",
    "build:deploy": "pnpm -r --filter @webmoti-employ/shared --filter @webmoti-employ/client build",
    "lint": "eslint . && pnpm run stylelint",
    "lint:fix": "eslint . --fix",
    "stylelint": "stylelint **/*.css",
    "vitest:watch": "vitest",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mantine/core": "8.3.13",
    "@mantine/dates": "8.3.13",
    "@mantine/form": "8.3.13",
    "@mantine/hooks": "8.3.13",
    "@mantine/notifications": "8.3.13",
    "@mediapipe/tasks-vision": "0.10.32",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-query": "5.90.20",
    "@tanstack/react-router": "1.157.5",
    "@tanstack/react-virtual": "3.13.18",
    "@webmoti-employ/shared": "workspace:^",
    "@zoom/videosdk": "2.3.12",
    "better-auth": "catalog:",
    "linkify-react": "^4.3.2",
    "linkifyjs": "^4.3.2",
    "luxon": "^3.7.2",
    "mantine-form-zod-resolver": "^1.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-speech-recognition": "^4.0.1",
    "react-use-websocket": "4.13.0",
    "zod": "catalog:",
    "zustand": "5.0.10"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^2.7.2",
    "@playwright/test": "^1.58.0",
    "@tanstack/router-plugin": "1.157.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.0.10",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@types/react-speech-recognition": "^3.9.6",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint-plugin-format": "^1.3.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "27.4.0",
    "postcss": "8.5.6",
    "postcss-preset-mantine": "1.18.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "6.0.5"
  }
}
