{
  "name": "@webmoti-employ/client",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:electron": "pnpm run dev",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck && vite build",
    "install:deploy": "pnpm install --filter @webmoti-employ/shared --filter @webmoti-employ/client",
    "build:deploy": "pnpm -r --filter @webmoti-employ/shared --filter @webmoti-employ/client build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "stylelint": "stylelint '**/*.css' --cache",
    "vitest": "vitest run",
    "vitest:watch": "vitest",
    "test": "pnpm run typecheck && pnpm run lint && pnpm run vitest && pnpm run build"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.35.3",
    "@mantine/core": "8.1.3",
    "@mantine/dates": "^8.1.3",
    "@mantine/form": "^8.1.3",
    "@mantine/hooks": "8.1.3",
    "@mantine/notifications": "^8.1.3",
    "@tabler/icons-react": "^3.34.0",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.128.0",
    "@webmoti-employ/shared": "workspace:^",
    "@zoom/videosdk": "^2.2.5",
    "linkify-react": "^4.3.1",
    "linkifyjs": "^4.3.1",
    "luxon": "^3.7.1",
    "mantine-form-zod-resolver": "^1.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.5",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.17.0",
    "@clerk/types": "^4.68.0",
    "@eslint-react/eslint-plugin": "^1.52.3",
    "@tanstack/router-plugin": "^1.128.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/luxon": "^3.6.2",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.31.0",
    "eslint-plugin-format": "^1.0.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "stylelint": "^16.20.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vite": "^7.0.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.3"
  }
}
