    "@types/pg": "^8.15.4",
    "@web-employ/shared": "workspace:^",
    "hono": "^4.8.3",
    "jose": "^6.0.11",
    "kysely": "^0.28.2",
    "pg": "^8.16.3",
    "zod": "catalog:deps"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "eslint": "catalog:dev",
    "globals": "^16.2.0",
    "kysely-codegen": "^0.18.5",
    "typescript-eslint": "^8.35.1",
    "wrangler": "^4.24.3"
  }
