{
  "name": "@webmoti-employ/server",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --remote",
    "dev:electron": "pnpm run dev",
    "deploy": "wrangler deploy --minify",
    "install:deploy": "pnpm install --filter @webmoti-employ/shared --filter @webmoti-employ/server",
    "cf-typegen": "wrangler types src/worker-configuration.d.ts --env-interface CloudflareBindings",
    "db-typegen": "kysely-codegen",
    "postinstall": "node scripts/postinstall.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@hono/clerk-auth": "^3.0.2",
    "@hono/zod-validator": "^0.7.1",
    "@types/pg": "^8.15.4",
    "@webmoti-employ/shared": "workspace:^",
    "hono": "^4.8.5",
    "jose": "^6.0.11",
    "kysely": "^0.28.2",
    "pg": "^8.16.3",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.16.2",
    "eslint": "^9.31.0",
    "globals": "^16.2.0",
    "kysely-codegen": "^0.18.5",
    "typescript-eslint": "^8.37.0",
    "wrangler": "^4.24.3"
  }
}
