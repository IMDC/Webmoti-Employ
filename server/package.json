{
  "name": "@webmoti-employ/server",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "pnpm --prefix .. start",
    "dev": "wrangler dev",
    "dev:electron": "pnpm run dev",
    "test": "vitest run",
    "vitest:watch": "vitest",
    "deploy": "wrangler deploy --minify",
    "install:deploy": "pnpm install --filter @webmoti-employ/shared --filter @webmoti-employ/server",
    "cf-typegen": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings",
    "db:typegen": "kysely-codegen",
    "db:better-auth-gen": "pnpm dlx @better-auth/cli@latest generate --config ./better-auth.config.ts --output ./src/db/better-auth-schema.sql",
    "db:better-auth-migrate": "pnpm dlx @better-auth/cli@latest migrate --config ./better-auth.config.ts",
    "postinstall": "node scripts/postinstall.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate": "kysely migrate latest"
  },
  "dependencies": {
    "@ai-sdk/groq": "3.0.15",
    "@hono-rate-limiter/cloudflare": "^0.2.2",
    "@hono/zod-validator": "^0.7.6",
    "@speechmatics/auth": "^0.1.0",
    "@webmoti-employ/shared": "workspace:^",
    "ai": "6.0.49",
    "better-auth": "catalog:",
    "hono": "4.11.5",
    "hono-rate-limiter": "^0.5.3",
    "jose": "^6.1.3",
    "kysely": "^0.28.10",
    "pg": "8.17.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.6",
    "@types/pg": "^8.16.0",
    "dotenv": "^17.2.3",
    "globals": "^17.1.0",
    "kysely-codegen": "^0.19.0",
    "kysely-ctl": "^0.20.0",
    "wrangler": "4.49.1"
  }
}
