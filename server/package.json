{
  "name": "@webmoti-employ/server",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "dev:electron": "pnpm run dev",
    "test": "vitest",
    "deploy": "wrangler deploy --minify",
    "install:deploy": "pnpm install --filter @webmoti-employ/shared --filter @webmoti-employ/server",
    "cf-typegen": "wrangler types src/types/worker-configuration.d.ts --env-interface CloudflareBindings",
    "db-typegen": "kysely-codegen",
    "postinstall": "node scripts/postinstall.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@hono-rate-limiter/cloudflare": "^0.2.2",
    "@hono/clerk-auth": "^3.0.2",
    "@hono/zod-validator": "^0.7.2",
    "@webmoti-employ/shared": "workspace:^",
    "hono": "^4.8.5",
    "hono-rate-limiter": "^0.4.2",
    "jose": "^6.0.12",
    "kysely": "^0.28.3",
    "pg": "^8.16.3",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.0.0",
    "@cloudflare/vitest-pool-workers": "^0.8.56",
    "@types/pg": "^8.15.4",
    "eslint": "^9.31.0",
    "globals": "^16.2.0",
    "kysely-codegen": "^0.18.5",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.25.0"
  }
}
