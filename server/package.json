{
  "name": "@webmoti-employ/server",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "dev:electron": "pnpm run dev",
    "test": "vitest run",
    "vitest:watch": "vitest",
    "deploy": "wrangler deploy --minify",
    "install:deploy": "pnpm install --filter @webmoti-employ/shared --filter @webmoti-employ/server",
    "cf-typegen": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings",
    "db:typegen": "kysely-codegen",
    "db:better-auth-gen": "pnpm dlx @better-auth/cli@latest generate --config ./better-auth.config.ts --output ./src/db/better-auth-schema.sql",
    "db:better-auth-migrate": "pnpm dlx @better-auth/cli@latest migrate --config ./better-auth.config.ts",
    "postinstall": "node scripts/postinstall.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@hono-rate-limiter/cloudflare": "^0.2.2",
    "@hono/zod-validator": "^0.7.2",
    "@webmoti-employ/shared": "workspace:^",
    "better-auth": "^1.3.7",
    "hono": "^4.9.2",
    "hono-rate-limiter": "^0.4.2",
    "jose": "^6.1.0",
    "kysely": "^0.28.5",
    "pg": "^8.16.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.2.1",
    "@cloudflare/vitest-pool-workers": "^0.8.68",
    "@types/pg": "^8.15.5",
    "dotenv": "^17.2.1",
    "eslint": "^9.35.0",
    "globals": "^16.2.0",
    "kysely-codegen": "^0.18.5",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.33.2"
  }
}
