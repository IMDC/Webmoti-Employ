{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "webmoti-employ",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-28",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "c6260ef32ee74770839d3285df95118c"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "unsafe": {
    "bindings": [
      {
        "name": "PUBLIC_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": {
          "limit": 500,
          "period": 60
        }
      },
      {
        "name": "USER_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 250,
          "period": 60
        }
      }
    ]
  }
}
